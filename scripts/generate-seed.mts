/**
 * Generates supabase/seed.sql (demo CATALOGUE only) and supabase/demo-enquiries.sql
 * (clearly flagged demo enquiries) from src/data/demo-data.ts.
 * Run: npm run seed:generate
 */
import { writeFileSync } from "node:fs";
import { demoCategories, demoEnquiries, demoProducts, demoProjects } from "../src/data/demo-data.ts";

const q = (v: unknown) => (v === null || v === undefined ? "null" : `'${String(v).replace(/'/g, "''")}'`);
const j = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;

let seed = `-- DEMO CATALOGUE SEED (generated by scripts/generate-seed.mts). Do not run in production
-- unless you want the illustrative catalogue. Rows are flagged is_demo = true.
-- Image paths point at /public/images, which ships with the site.\n\n`;

seed += "insert into public.categories (name, slug, description, image, is_active, is_demo) values\n";
seed += demoCategories.map((c) => `  (${q(c.name)}, ${q(c.slug)}, ${q(c.description)}, ${q(c.image)}, true, true)`).join(",\n");
seed += "\non conflict (slug) do nothing;\n\n";

for (const p of demoProducts) {
  seed += `insert into public.products (name, slug, short_description, description, category_id, images, specifications, customization_options, moq, is_featured, is_active, is_demo)
select ${q(p.name)}, ${q(p.slug)}, ${q(p.shortDescription)}, ${q(p.description)}, c.id, ${j(p.images)}, ${j(p.specifications)}, ${j(p.customizationOptions)}, ${p.moq ?? "null"}, ${p.isFeatured}, true, true
from public.categories c where c.slug = ${q(p.categorySlug)}
on conflict (slug) do nothing;\n`;
}

seed += "\n";
for (const p of demoProjects) {
  seed += `insert into public.portfolio_projects (title, slug, category, description, images, details, is_featured, is_demo) values (${q(p.title)}, ${q(p.slug)}, ${q(p.category)}, ${q(p.description)}, ${j(p.images)}, ${j(p.details)}, ${p.isFeatured}, true) on conflict (slug) do nothing;\n`;
}
writeFileSync("supabase/seed.sql", seed);

let enq = `-- DEMO ENQUIRIES (generated). OPTIONAL and for demonstrations only. Every row has
-- is_demo = true and a DEMO- reference, so they are never confused with real customer enquiries.\n\n`;
for (const e of demoEnquiries) {
  enq += `with e as (
  insert into public.enquiries (enquiry_number, customer_name, company_name, email, phone, quantity, budget_range, delivery_date, customization_requirements, notes, status, is_demo, created_at)
  values (${q(e.enquiryNumber)}, ${q(e.customerName)}, ${q(e.companyName)}, ${q(e.email)}, ${q(e.phone)}, ${e.items.reduce((s, i) => s + i.quantity, 0)}, ${q(e.budgetRange)}, ${q(e.deliveryDate)}, ${q(e.customizationRequirements)}, ${q(e.notes ?? "Illustrative demo record.")}, ${q(e.status)}, true, ${q(e.createdAt)})
  on conflict (enquiry_number) do nothing returning id)
insert into public.enquiry_items (enquiry_id, product_name, quantity)
select e.id, v.name, v.qty from e, (values ${e.items.map((i) => `(${q(i.productName)}, ${i.quantity})`).join(", ")}) as v(name, qty);\n`;
}
writeFileSync("supabase/demo-enquiries.sql", enq);
console.log(`seed.sql: ${demoProducts.length} products, ${demoCategories.length} categories, ${demoProjects.length} projects; demo-enquiries.sql: ${demoEnquiries.length} enquiries`);
