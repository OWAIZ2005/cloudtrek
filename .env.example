# ------------------------------------------------------------------
# Cloud Trek — environment variables (placeholders only; never commit real values)
# Copy to .env.local for development. Set the same names in
# Vercel > Project > Settings > Environment Variables (Production + Preview).
# ------------------------------------------------------------------

# Public site URL (sitemap, canonical URLs, Open Graph, links inside emails)
NEXT_PUBLIC_SITE_URL=https://cloud-trek.vercel.app

# --- Supabase (leave empty to run the site in DEMO mode) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (Supabase > Project Settings > API Keys). The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# SERVER ONLY (secret key; legacy name SUPABASE_SERVICE_ROLE_KEY also works). Never prefix with NEXT_PUBLIC_. Used to store enquiries/messages and uploads.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- Email notifications via Resend ------------------------------------------
# SERVER ONLY.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Recipient of every quote enquiry and contact message. While using Resend's test sender this MUST be the
# email address that owns the Resend account; later change it to aslam@cloudtrekbh.com.
CLOUDTREK_ENQUIRY_EMAIL=aslam@cloudtrekbh.com
# Sender. The domain MUST be verified in Resend (DNS records), e.g.
# "Cloud Trek <enquiries@cloudtrekbh.com>"
# Leave unset to use the test sender "Cloud Trek <onboarding@resend.dev>". After verifying the domain:
CLOUDTREK_FROM_EMAIL="Cloud Trek <quotations@cloudtrekbh.com>"
# Optional: also email the customer a bilingual receipt (true / false). Default: false.
CLOUDTREK_SEND_CUSTOMER_CONFIRMATION=false

# --- Company details (EDITABLE — unverified until supplied) ------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only incl. country code, e.g. 973XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Google Maps "Embed a map" iframe src URL
NEXT_PUBLIC_MAP_EMBED_URL=
