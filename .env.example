# ------------------------------------------------------------------
# Cloud Trek — environment variables (placeholders only; never commit real values)
# Copy to .env.local for development. Set the same names in Vercel > Settings > Environment Variables.
# ------------------------------------------------------------------

# Public site URL (used for sitemap, canonical URLs and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Supabase (leave empty to run the site in DEMO mode) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used to store enquiries and uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email notifications via Resend (optional) -------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Cloud Trek <enquiries@your-verified-domain.example>"
ADMIN_NOTIFY_EMAIL=admin@your-domain.example

# --- Company details (EDITABLE — all unverified until supplied) --------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only incl. country code, e.g. 973XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Google Maps "Embed a map" iframe src URL
NEXT_PUBLIC_MAP_EMBED_URL=
